{
  "name": "acestudio-workflow-extension-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "api:check": "node scripts/api-extractor.mjs",
    "api:update": "node scripts/api-extractor.mjs --local",
    "check:exports": "node scripts/check-exports.mjs",
    "docs": "typedoc",
    "docs:check": "node scripts/check-docs.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run api:check && npm run check:exports && npm run docs:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^24",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "publint": "^0.3.22",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
