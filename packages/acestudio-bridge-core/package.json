{
  "name": "@timedomain/acestudio-bridge-core",
  "version": "0.1.1",
  "type": "module",
  "description": "Control a running ACE Studio from your own code. The layer under the workflow extension SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/acestudio-bridge-core"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["LICENSE", "dist", "src"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
