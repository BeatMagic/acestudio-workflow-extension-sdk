{
  "name": "@timedomain/acestudio-workflow-extension-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Build workflow extensions for ACE Studio, the all-in-one AI music studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/acestudio-workflow-extension-sdk"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "acestudio:source": "./src/page/index.ts",
      "types": "./dist/src/page/index.d.ts",
      "default": "./dist/page/index.js"
    }
  },
  "dependencies": {
    "@timedomain/acestudio-bridge-core": "^0.2.0"
  },
  "files": ["LICENSE", "dist", "src"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
