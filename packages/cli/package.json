{
  "name": "@timedomain/aceworkflow",
  "version": "0.1.0",
  "type": "module",
  "description": "The ACE Studio workflow-extension CLI: pack, submit, and verify .aceworkflow bundles against the signing service. A pure client of the submission API.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aceworkflow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@timedomain/workflowext-signed-json": "*",
    "@timedomain/workflowext-verifier": "*",
    "@timedomain/workflowext-wire-schemas": "*"
  },
  "files": ["dist"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
