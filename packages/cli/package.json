{
  "name": "@timedomain/aceworkflow",
  "version": "0.1.3",
  "type": "module",
  "description": "Package, sign, and verify your ACE Studio extension before publishing it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aceworkflow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@timedomain/acestudio-workflow-extension-sdk": "*",
    "@timedomain/workflowext-signed-json": "*",
    "@timedomain/workflowext-verifier": "*",
    "@timedomain/workflowext-wire-schemas": "*"
  },
  "files": [
    "LICENSE",
    "dist",
    "src"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
