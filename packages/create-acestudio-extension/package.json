{
  "name": "@timedomain/create-acestudio-extension",
  "version": "0.1.0",
  "type": "module",
  "description": "The npm create-native scaffolder for ACE Studio workflow extensions: emits a working extension and its AGENTS.md, no running Studio required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/create-acestudio-extension"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-acestudio-extension": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["LICENSE", "TEMPLATE-LICENSE", "dist", "src", "templates"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
