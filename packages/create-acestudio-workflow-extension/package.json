{
  "name": "@timedomain/create-acestudio-workflow-extension",
  "version": "0.1.4",
  "type": "module",
  "description": "Scaffold a new ACE Studio workflow extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/create-acestudio-workflow-extension"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-acestudio-workflow-extension": "./dist/cli.js"
  },
