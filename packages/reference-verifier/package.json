{
  "name": "@timedomain/workflowext-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference verifier for ACE Studio extension signatures — implements the client verification policy so tests assert what a real client will conclude. Ships the golden test vectors.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@timedomain/workflowext-signed-json": "^0.1.0",
    "@timedomain/workflowext-wire-schemas": "^0.1.0"
  },
  "devDependencies": {
    "ajv": "^8"
  },
  "files": ["dist"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
