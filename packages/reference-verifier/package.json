{
  "name": "@timedomain/workflowext-verifier",
  "version": "0.1.2",
  "type": "module",
  "description": "Checks that an ACE Studio extension really came from its publisher and was not altered.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/reference-verifier"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@timedomain/workflowext-signed-json": "^0.1.0",
    "@timedomain/workflowext-wire-schemas": "^0.1.0"
  },
  "devDependencies": {
    "ajv": "^8"
  },
  "files": ["LICENSE", "dist", "src"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
