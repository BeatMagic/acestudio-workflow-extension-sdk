{
  "name": "@timedomain/workflowext-signed-json",
  "version": "0.1.3",
  "type": "module",
  "description": "Ed25519 signatures over JSON documents, the building block behind ACE Studio's signed extensions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMagic/acestudio-workflow-extension-sdk.git",
    "directory": "packages/signed-json"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "acestudio:source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["LICENSE", "dist", "src"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
