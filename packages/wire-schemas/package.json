{
  "name": "@timedomain/workflowext-wire-schemas",
  "version": "0.1.0",
  "type": "module",
  "description": "Versioned JSON Schemas for the six ACE Studio extension-signing wire formats — the normative contract consumed by the Studio client verification module.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "dependencies": {
    "@timedomain/workflowext-signed-json": "^0.1.0"
  },
  "devDependencies": {
    "ajv": "^8"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
