{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acestudio.ai/workflowext-signing/key-directory.v1.schema.json",
  "title": "Key directory (v1)",
  "description": "The root-signed served file listing currently-valid and revoked intermediates; changes only at ceremonies. The root object is the wire form; `payload` is base64 of the exact signed bytes, which decode to a JSON object valid against `#/$defs/payload`. Root-signed directly, so the envelope carries no chain — clients resolve the signature against their embedded root public keys.",
  "type": "object",
  "required": ["payload", "signature"],
  "additionalProperties": false,
  "properties": {
    "payload": { "$ref": "#/$defs/base64" },
    "signature": { "$ref": "#/$defs/ed25519Signature" }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["format", "formatVersion", "sequence", "issuedAt", "signedBy", "intermediates", "revokedIntermediates", "rootRevocations"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "acestudio.workflowext.key-directory" },
        "formatVersion": { "const": 1 },
        "sequence": { "$ref": "#/$defs/sequence" },
        "issuedAt": { "$ref": "#/$defs/unixSeconds" },
        "signedBy": { "$ref": "#/$defs/keyId" },
        "intermediates": {
          "description": "Certificate statements (root-signed) of currently-valid intermediates; payloads decode per certificate-statement.v1.schema.json.",
          "type": "array",
          "items": { "$ref": "#/$defs/certificateEnvelope" }
        },
        "revokedIntermediates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["keyId", "revokedFrom"],
            "additionalProperties": false,
            "properties": {
              "keyId": { "$ref": "#/$defs/keyId" },
              "revokedFrom": { "$ref": "#/$defs/unixSeconds" }
            }
          }
        },
        "rootRevocations": {
          "description": "Root-revocation statements travel with the key directory; payloads decode per root-revocation-statement.v1.schema.json. Empty in the happy case.",
          "type": "array",
          "items": { "$ref": "#/$defs/rootRevocationEnvelope" }
        }
      }
    },
    "base64": {
      "description": "Standard-alphabet base64 with padding.",
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ed25519Signature": {
      "description": "base64 of a raw 64-byte Ed25519 signature.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "certificateEnvelope": {
      "type": "object",
      "required": ["payload", "signature"],
      "additionalProperties": false,
      "properties": {
        "payload": { "$ref": "#/$defs/base64" },
        "signature": { "$ref": "#/$defs/ed25519Signature" }
      }
    },
    "rootRevocationEnvelope": {
      "type": "object",
      "required": ["payload", "signature"],
      "additionalProperties": false,
      "properties": {
        "payload": { "$ref": "#/$defs/base64" },
        "signature": { "$ref": "#/$defs/ed25519Signature" }
      }
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "sequence": {
      "description": "Strictly monotonic publish sequence; clients ratchet forward and refuse older files. Never regresses, including across service restores.",
      "type": "integer",
      "minimum": 1
    },
    "unixSeconds": {
      "description": "Unix time in seconds, UTC.",
      "type": "integer",
      "minimum": 0
    }
  }
}
