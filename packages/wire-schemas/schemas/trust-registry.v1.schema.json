{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acestudio.ai/workflowext-signing/trust-registry.v1.schema.json",
  "title": "Trust registry (v1)",
  "description": "The intermediate-signed served file mapping developer ids to display names and elevated tiers — elevated tiers only; names and tiers are server-authoritative, never carried by bundles. The root object is the wire form; `payload` is base64 of the exact signed bytes, which decode to a JSON object valid against `#/$defs/payload`.",
  "type": "object",
  "required": ["payload", "signature", "chain"],
  "additionalProperties": false,
  "properties": {
    "payload": { "$ref": "#/$defs/base64" },
    "signature": { "$ref": "#/$defs/ed25519Signature" },
    "chain": {
      "description": "The signing intermediate's certificate statement, root-signed. Exactly one link in v1.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/certificateEnvelope" }
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["format", "formatVersion", "sequence", "issuedAt", "signedBy", "entries"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "acestudio.workflowext.trust-registry" },
        "formatVersion": { "const": 1 },
        "sequence": { "$ref": "#/$defs/sequence" },
        "issuedAt": { "$ref": "#/$defs/unixSeconds" },
        "signedBy": { "$ref": "#/$defs/keyId" },
        "entries": {
          "description": "Keyed by developer id. Only `official` and `verified-partner` appear; absence means unsigned-tier treatment.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/developerSlug" },
          "additionalProperties": {
            "type": "object",
            "required": ["displayName", "tier"],
            "additionalProperties": false,
            "properties": {
              "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
              "tier": { "enum": ["official", "verified-partner"] }
            }
          }
        }
      }
    },
    "base64": {
      "description": "Standard-alphabet base64 with padding.",
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ed25519Signature": {
      "description": "base64 of a raw 64-byte Ed25519 signature.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "certificateEnvelope": {
      "description": "A certificate statement envelope; its payload decodes per certificate-statement.v1.schema.json.",
      "type": "object",
      "required": ["payload", "signature"],
      "additionalProperties": false,
      "properties": {
        "payload": { "$ref": "#/$defs/base64" },
        "signature": { "$ref": "#/$defs/ed25519Signature" }
      }
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "developerSlug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "sequence": {
      "description": "Strictly monotonic publish sequence; clients ratchet forward and refuse older files. Never regresses, including across service restores.",
      "type": "integer",
      "minimum": 1
    },
    "unixSeconds": {
      "description": "Unix time in seconds, UTC.",
      "type": "integer",
      "minimum": 0
    }
  }
}
