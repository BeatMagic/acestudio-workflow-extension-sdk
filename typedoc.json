{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "entryPoints": [
    "packages/acestudio-bridge-core/src/index.ts",
    "packages/acestudio-workflow-extension-sdk/src/index.ts",
    "packages/acestudio-workflow-extension-sdk/src/page/index.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "excludeInternal": true,
  "githubPages": false,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "disableSources": true,
  "expandObjects": true
}
